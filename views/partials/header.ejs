<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Mobile menu toggle
        const menuButton = document.querySelector('.mobile-menu-button');
        const mobileMenu = document.querySelector('.mobile-menu');
        let isMenuOpen = false;

        menuButton.addEventListener('click', function() {
            isMenuOpen = !isMenuOpen;
            menuButton.classList.toggle('active');
            mobileMenu.classList.toggle('active');
            document.body.style.overflow = isMenuOpen ? 'hidden' : '';
        });

        // Features section toggle
        const featuresToggle = document.querySelector('.features-toggle');
        const featureLinks = document.querySelector('.feature-links');
        const toggleIcon = document.querySelector('.toggle-icon');

        featuresToggle.addEventListener('click', function() {
            featureLinks.classList.toggle('collapsed');
            toggleIcon.classList.toggle('active');
        });

        // Close menu when clicking on a link within the feature links
        const mobileMenuLinks = mobileMenu.querySelectorAll('a');

        mobileMenuLinks.forEach(link => {
            link.addEventListener('click', () => {
                isMenuOpen = false;
                menuButton.classList.remove('active');
                mobileMenu.classList.remove('active');
                document.body.style.overflow = '';
            });
        });
    });
</script>