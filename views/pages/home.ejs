<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<div id="page" class="home">
    <div class="email-confirmed">
        <div class="container">
            Email confirmed successfully
        </div>
    </div>

    <section class="hero">
        <div class="hero-content">
            <div class="tagline">
                <h1>
                    <div><span class="">Life is Better</span></div>
                    <div><span class="real">In-Person</span></div>
                </h1>
            </div>

            <div class="coming-soon">
                <div class="text">Arriving</div>
                <div class="circle">20<span class="twenty-five">25</span></div>
            </div>

            <div class="signup-form">
                <div class="form">
                    <div class="error-message"></div>
                    <input type="email" placeholder="Your Email">
                    <div class="button"><span>Sign Up</span></div>
                </div>
                <div class="success-message"></div>
            </div>
        </div>
        <div class="hero-image-container">
            <div class="hero-image"></div>
        </div>

    </section>

    <div class="preview">
        <section id="preview-real-time" class="section real-time">
            <div class="section-content">
                <h2>Real-Time <span class="badge">Live</span></h2>
                <div class="description">Send and receive activity notifications from new and existing friends in real-time.</div>
                <div class="button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
            <div class="video-container">
                <video controls muted="muted" playsinline -webkit-playsinline poster="https://befriend.s3.amazonaws.com/preview/real-time.jpg">
                    <source src="https://befriend.s3.amazonaws.com/preview/real-time.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>

                <div class="mobile-button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
        </section>

        <section id="preview-activity-types" class="section activity-types">
            <div class="slides-container">
                <div class="activity-types-container">
                    <div class="swiper activitySwiper">
                        <div class="swiper-wrapper"></div>
                        <div class="swiper-pagination"></div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                    </div>
                </div>

                <div class="mobile-button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
            <div class="section-content">
                <h2>Activity Types <span class="badge">Dynamic</span></h2>
                <div class="description">Enjoy over 12 main activity categories and nearly 300 subcategories.</div>
                <div class="button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
        </section>

        <section id="preview-multi-person" class="section multi-person">
            <div class="section-content">
                <h2>Multi-Person <span class="badge">Group</span></h2>
                <div class="description">Invite more than one person for an activity. Create group events and expand your social circle together.</div>
                <div class="button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
            <div class="video-container">
                <video controls muted="muted" playsinline -webkit-playsinline poster="https://befriend.s3.amazonaws.com/preview/multi-person.jpg">
                    <source src="https://befriend.s3.amazonaws.com/preview/multi-person.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>

                <div class="mobile-button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
        </section>

        <section id="preview-filters" class="section filters">
            <div class="section-content">
                <h2>Smart Filters <span class="badge">Intelligence</span></h2>
                <div class="description">Combine 20+ state-of-the-art filters to find your best friends in record time.</div>
                <div class="info">Bi-directional filter system ensures notifications are welcome on both sides.</div>
                <div class="button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>

            <div class="slides-container">
                <div class="filters-container">
                    <div class="swiper activitySwiper">
                        <div class="swiper-wrapper"></div>
                        <div class="swiper-pagination"></div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                    </div>
                </div>

                <div class="mobile-button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
        </section>

        <section id="preview-kids-mode" class="section kids-mode">
            <div class="video-container">
                <video controls muted="muted" playsinline -webkit-playsinline poster="https://befriend.s3.amazonaws.com/preview/kids-mode.jpg">
                    <source src="https://befriend.s3.amazonaws.com/preview/kids-mode.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>

                <div class="mobile-button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
            <div class="section-content">
                <h2>Kids Mode <span class="badge">Family</span></h2>
                <div class="description">Befriend is designed for parents to connect with other families during kid-friendly activities, helping both adults and children make new friends easily.</div>
                <div class="button-container">
                    <div class="button">Join Waitlist</div>
                </div>
            </div>
        </section>

        <section id="preview-networks" class="section networks">
            <div class="video-container">
                <video controls muted="muted" playsinline -webkit-playsinline poster="https://befriend.s3.amazonaws.com/preview/3rd-party-networks.jpg">
                    <source src="https://befriend.s3.amazonaws.com/preview/3rd-party-networks.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>

                <div class="mobile-button-container">
                    <a target="_blank" href="https://github.com/orgs/befriend-app/repositories"><div class="source-button">View Source Code</div></a>
                </div>
            </div>

            <div class="section-content">
                <h2>3rd-Party Networks <span class="badge">Open Source</span></h2>
                <div class="description">
                    <div>Our open-source platform empowers brands and developers to create their own in-person friend networks.</div>
                    <div>When LIVE, users across all networks can connect with each other, significantly expanding potential matches.</div>
                    <div>By uniting these networks, we're building a global community where one billion people can finally create authentic friendships through technology.</div>
                    <div>Together, we can increase the consciousness of happiness on Earth while creating a world with less depression, less isolation, and more real-time, meaningful human connections in person.</div>
                </div>
                <div class="button-container">
                    <a target="_blank" href="https://github.com/orgs/befriend-app/repositories"><div class="source-button">View Source Code</div></a>
                </div>
            </div>
        </section>

        <section class="section final-cta">
            <div class="content">
                <h2>Ready to find your <span class="highlight">real</span> friends?</h2>
                <p>Join thousands of others creating meaningful connections</p>
                <div class="signup">
                    <div class="button">Sign Up Now</div>
                </div>
            </div>
        </section>
    </div>
</div>

<%- contentFor('scripts')%>

<script>
    let hero_el = document.querySelector('.hero');

    function signup() {
        let button_el = hero_el.querySelector('.form').querySelector('.button');
        let input_el = hero_el.querySelector('input');
        let error_el = hero_el.querySelector('.error-message');
        let success_el = hero_el.querySelector('.success-message');

        button_el.addEventListener('click', async function (e) {
            if(this._ip) {
                return;
            }

            e.preventDefault();
            e.stopPropagation();

            if(!input_el.value) {
                return;
            }

            this._ip = true;

            removeClassEl('show', error_el);
            removeClassEl('show', success_el);

            let email = input_el.value;

            if(!isValidEmail(email)) {
                addClassEl('show', error_el);
                error_el.innerHTML = 'Invalid email';
            } else {
                try {
                    await axios.post('/waitlist', {
                        email
                    });

                    input_el.value = '';

                    addClassEl('show', success_el);
                    success_el.innerHTML = 'Thank you for signing up!';
                } catch(e) {
                    addClassEl('show', error_el);
                    error_el.innerHTML = e?.response?.data?.msg;
                    console.error(e);
                }
            }

            this._ip = false;
        });

        input_el.addEventListener('keydown', function (e) {
            if(!input_el.value) {
                return;
            }

            removeClassEl('show', error_el);
            removeClassEl('show', success_el);

            if(e.key === 'Enter') {
                fireClick(button_el);
            }
        });

        document.querySelectorAll('.signup .button, .button-container .button, .mobile-button-container .button')
            .forEach(button => {
                button.addEventListener('click', function (e) {
                    hero_el.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                });
            });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const preloadNext = (n, swiper) => {
            swiper
                .slides
                .slice(swiper.activeIndex, swiper.activeIndex + n + 1)
                .map(slide => slide.querySelector('img'))
                .forEach(s => s.setAttribute('loading', 'eager'));
        };

        // Activity Types Data
        const activityTypes = [
            { name: 'Meet', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/meet.png' },
            { name: 'Eat', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/eat.png' },
            { name: 'Eat', sub: 'by Food Type', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/eat-food-type.png' },
            { name: 'Drink', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/drink.png' },
            { name: 'Walk', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/walk.png' },
            { name: 'Exercise', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/exercise.png' },
            { name: 'Watch', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/watch.png' },
            { name: 'Fun', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/fun.png' },
            { name: 'Dance', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/dance.png' },
            { name: 'Attend', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/attend.png' },
            { name: 'Attend', sub: 'by Sports Type', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/attend-sports-type.png' },
            { name: 'Attend', sub: 'by Music Type', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/attend-music-type.png' },
            { name: 'Relax', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/relax.png' },
            { name: 'Discover', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/discover.png' },
            { name: 'Shop', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/shop.png' },
            { name: 'Kids', icon: 'https://befriend.s3.amazonaws.com/preview/activity-types/kids.png' }
        ];

        // Filters Data with descriptions
        const filters = [
            { name: 'Availability', description: `Choose when to receive notifications`, icon: 'https://befriend.s3.amazonaws.com/preview/filters/availability.png' },
            { name: 'Activity Types', description: 'Filter by preferred activities', icon: 'https://befriend.s3.amazonaws.com/preview/filters/activity-types.png' },
            { name: 'Modes', description: `Meet fellow solo travelers, couples, or families`, icon: 'https://befriend.s3.amazonaws.com/preview/filters/modes.png' },
            { name: 'Networks', description: `Connect with in-person friends across the entire Befriend network`, icon: 'https://befriend.s3.amazonaws.com/preview/filters/networks.png' },
            { name: 'Reviews', description: 'Stay safe, find high-quality friends, and meet new people with confidence', icon: 'https://befriend.s3.amazonaws.com/preview/filters/reviews.png' },
            { name: 'Verifications', description: 'Connect with verified persons', icon: 'https://befriend.s3.amazonaws.com/preview/filters/verifications.png' },
            { name: 'Distance', description: 'Discover friends nearby and in neighboring cities', icon: 'https://befriend.s3.amazonaws.com/preview/filters/distance.png' },
            { name: 'Age', description: 'Find friends in your age range', icon: 'https://befriend.s3.amazonaws.com/preview/filters/age.png' },
            { name: 'Genders', description: 'Filter by gender preference', icon: 'https://befriend.s3.amazonaws.com/preview/filters/genders.png' },
            { name: 'Movies', description: 'Find friends with similar movie tastes', icon: 'https://befriend.s3.amazonaws.com/preview/filters/movies.png' },
            { name: 'TV Shows', description: 'Connect through favorite TV shows', icon: 'https://befriend.s3.amazonaws.com/preview/filters/tv-shows.png' },
            { name: 'Sports', description: 'Find friends who are passionate about the same teams, leagues, and sports', icon: 'https://befriend.s3.amazonaws.com/preview/filters/sports.png' },
            { name: 'Music', description: 'Connect through shared music interests', icon: 'https://befriend.s3.amazonaws.com/preview/filters/music.png' },
            { name: 'Instruments', description: 'Connect with fellow musicians', icon: 'https://befriend.s3.amazonaws.com/preview/filters/instruments.png' },
            { name: 'Schools', description: 'Find alumni from your middle school, high school, or university', icon: 'https://befriend.s3.amazonaws.com/preview/filters/schools.png' },
            { name: 'Work', description: 'Connect with professionals by industry and role', icon: 'https://befriend.s3.amazonaws.com/preview/filters/work.png' },
            { name: 'Life Stages', description: 'Connect with people in a similar life stage', icon: 'https://befriend.s3.amazonaws.com/preview/filters/life-stages.png' },
            { name: 'Relationships', description: 'Find friends with similar relationship status', icon: 'https://befriend.s3.amazonaws.com/preview/filters/relationships.png' },
            { name: 'Languages', description: 'Find friends who speak your language', icon: 'https://befriend.s3.amazonaws.com/preview/filters/languages.png' },
            { name: 'Politics', description: 'Filter by political views', icon: 'https://befriend.s3.amazonaws.com/preview/filters/politics.png' },
            { name: 'Religions', description: 'Connect with people of similar faith', icon: 'https://befriend.s3.amazonaws.com/preview/filters/religions.png' },
            { name: 'Drinking', description: 'Find friends with similar drinking habits', icon: 'https://befriend.s3.amazonaws.com/preview/filters/drinking.png' },
            { name: 'Smoking', description: 'Filter by smoking preferences', icon: 'https://befriend.s3.amazonaws.com/preview/filters/smoking.png' },
        ];

        // Populate Activity Types Swiper
        const activitySwiperWrapper = document.querySelector('.activity-types .swiper-wrapper');

        // Generate activity type slides
        activityTypes.forEach(activity => {
            const slide = document.createElement('div');
            slide.className = 'swiper-slide';

            let sub_name = '';
            if(activity.sub) {
                sub_name = `<div class="activity-sub-name">${activity.sub}</div>`;
            }

            slide.innerHTML = `
          <div class="activity-card" data-activity="${activity.name.toLowerCase()}">
            <div class="activity-icon">
              <img src="${activity.icon}" alt="${activity.name}" loading="lazy" />
              <div class="swiper-lazy-preloader"></div>
            </div>
            <div class="name-container">
                <div class="activity-name">${activity.name}</div>
                ${sub_name}
            </div>
          </div>
        `;

            activitySwiperWrapper.appendChild(slide);
        });

        // Populate Filters Swiper
        const filterSwiperWrapper = document.querySelector('.filters .swiper-wrapper');

        // Generate filter slides
        filters.forEach(filter => {
            const slide = document.createElement('div');
            slide.className = 'swiper-slide';

            slide.innerHTML = `
          <div class="filter-card" data-filter="${filter.name.toLowerCase().replace(/\s+/g, '-')}">
            <div class="filter-icon">
              <img src="${filter.icon}" alt="${filter.name}" loading="lazy" />
              <div class="swiper-lazy-preloader"></div>
            </div>
            <div class="name-container">
                <div class="filter-name">${filter.name}</div>
                <div class="filter-description">${filter.description}</div>
            </div>
          </div>
        `;

            filterSwiperWrapper.appendChild(slide);
        });

        // Initialize Activity Types Swiper
        const activitySwiper = new Swiper('.activity-types .swiper', {
            slidesPerView: 1.3,
            spaceBetween: 10,
            grabCursor: true,
            lazyPreloadPrevNext: 2,
            pagination: {
                el: '.activity-types .swiper-pagination',
                clickable: true,
            },
            navigation: {
                nextEl: '.activity-types .swiper-button-next',
                prevEl: '.activity-types .swiper-button-prev',
            },
            breakpoints: {
                600: {
                    slidesPerView: 1.5,
                    spaceBetween: 15
                },
            }
        });

        // Initialize Filters Swiper
        const filterSwiper = new Swiper('.filters .swiper', {
            slidesPerView: 1.3,
            spaceBetween: 20,
            grabCursor: true,
            lazyPreloadPrevNext: 2,
            pagination: {
                el: '.filters .swiper-pagination',
                clickable: true,
            },
            navigation: {
                nextEl: '.filters .swiper-button-next',
                prevEl: '.filters .swiper-button-prev',
            },
            breakpoints: {
                600: {
                    slidesPerView: 1.5,
                    spaceBetween: 15
                },
            }
        });

        preloadNext(2, activitySwiper);
        preloadNext(2, filterSwiper);

        activitySwiper.on('slideChange', () => preloadNext(2, activitySwiper));
        filterSwiper.on('slideChange', () => preloadNext(2, filterSwiper));

        document.querySelectorAll('.activity-card').forEach(card => {
            card.addEventListener('click', function() {
                const activityType = this.getAttribute('data-activity');
                console.log(`Selected activity: ${activityType}`);
            });
        });

        document.querySelectorAll('.filter-card').forEach(card => {
            card.addEventListener('click', function() {
                const filterType = this.getAttribute('data-filter');
                console.log(`Selected filter: ${filterType}`);
            });
        });

        // Add smooth scrolling for section links
        document.querySelectorAll('a[href^="#preview-"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();

                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            });
        });

        // Initialize animations for sections (optional)
        const sections = document.querySelectorAll('.section');

        // Simple animation trigger on scroll
        const observeSection = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.2 });

        sections.forEach(section => {
            observeSection.observe(section);
        });
    });

    signup();

    if(window.location.search?.includes('confirm_success')) {
        addClassEl('show', document.querySelector('.email-confirmed'));
    }
</script>